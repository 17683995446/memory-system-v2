# 基于第一性原理的Agent可靠记忆系统 - 环境变量配置
# 复制此文件为 .env 并根据需要修改

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# 数据目录配置
DATA_DIR=/app/data

# L1记忆配置
L1_MAX_ITEMS=200
L1_MAX_TASKS=1000

# L2记忆配置
L2_DIMENSION=384
L2_TOP_K=5
L2_SIMILARITY_THRESHOLD=0.7
L2_CLEANUP_DAYS=30
L2_INDEX_FILE=/app/data/l2_index.faiss
L2_METADATA_FILE=/app/data/l2_metadata.json

# L3记忆配置
L3_DB_FILE=/app/data/l3_memory.db

# Embedding配置
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# 召回配置
RECALL_MAX_L1=3
RECALL_MAX_L2=5
RECALL_MAX_L3=2
RECALL_TOTAL_LIMIT=10

# API服务配置
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false
